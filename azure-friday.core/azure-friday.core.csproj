<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>azure_friday.core</RootNamespace>
    <UserSecretsId>7ca10719-ae7f-4892-8c43-31b30d369774</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LazyCache.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageReference Include="Microsoft.aspnet.webapi.client" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.2" />
  </ItemGroup>

  <!-- Build Tailwind CSS before publish (always) and before build (only if tailwind.css is missing) -->
  <Target Name="BuildTailwindCSS" BeforeTargets="Publish">
    <Exec Command="npm ci --ignore-scripts" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="npx tailwindcss -i wwwroot/css/input.css -o wwwroot/css/tailwind.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="EnsureTailwindCSS" BeforeTargets="Build" Condition="!Exists('wwwroot/css/tailwind.css')">
    <Message Text="tailwind.css not found — running Tailwind build..." Importance="high" />
    <Exec Command="npm install --ignore-scripts" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="npx tailwindcss -i wwwroot/css/input.css -o wwwroot/css/tailwind.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>