@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="max-w-2xl mx-auto px-4 py-16 text-center">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100">@ViewData["Title"]</h1>
    <p class="mt-4 text-lg text-red-600 dark:text-red-400">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
            <strong>Request ID:</strong> <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">@Model.RequestId</code>
        </p>
    }
    <a href="/" class="mt-8 inline-block px-6 py-3 rounded-lg bg-azure-500 text-white font-medium hover:bg-azure-600 transition-colors">
        Go to Homepage
    </a>
</section>
